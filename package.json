{
  "name": "jikan-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "og": "node scripts/render-og.mjs",
    "dev": "wrangler dev --remote",
    "dev:local": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply jikan-edge --local",
    "db:migrate:remote": "wrangler d1 migrations apply jikan-edge --remote",
    "benchmark": "vitest run tests/benchmarks"
  },
  "dependencies": {
    "hono": "^4.7.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260714.1",
    "@types/node": "^22.15.19",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.24.3"
  }
}
