# Wrangler local state — contains local D1/R2 data and cached account identity (id + email);
# must never be committed, at any depth (the spike has its own .wrangler dir too).
.wrangler/
**/.wrangler/

# Local secrets and scratch output
.dev.vars
*.log
*.jsonl

# A local allow-rule can carry a token; the file is per-machine and stays out of the repo.
**/.claude/settings.local.json

# macOS directory metadata
.DS_Store

# Derived kanban board (hexagram `board` skill). Regenerated by one sync command.
.kanban.json

# Derivado do .excalidraw.md, que e derivado do src/. Regenerar custa um comando
# e um SVG versionado e um terceiro lugar onde a mesma verdade pode apodrecer.
docs/architecture/diagrams/preview.svg

# Byte-code from the diagram generator in tools/.
__pycache__/
